# Your Ko-fi page username (the part after ko-fi.com/).
# Example: if your page is https://ko-fi.com/matthewj , this is "matthewj"
KOFI_USERNAME=your_kofi_username

# Get your verification token from: https://ko-fi.com/manage/webhooks
# Set the webhook URL there to: https://your-domain.com/api/webhook/kofi
# Then copy the verification token shown on that page.
KOFI_VERIFICATION_TOKEN=replace_with_your_token

# The public URL where your server is reachable.
# Locally with ngrok: https://your-id.ngrok-free.app
# In production: https://pixelwall.example
BASE_URL=http://localhost:3000

# Optional. Defaults to 3000.
PORT=3000

# Optional. Defaults to ./data/pixels.db
# On Railway/Fly use a path inside the persistent volume.
# DB_PATH=/data/pixels.db
